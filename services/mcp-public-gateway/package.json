{
  "name": "mcp-public-gateway",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "LoreWeave PUBLIC MCP edge — authenticates external-agent credentials, enforces per-key scope/rate/spend/audit, mints the internal envelope, and relays to ai-gateway/mcp. The single external entry for third-party agents (behind api-gateway-bff). P0: envelope hop + inbound-header strip + admin isolation.",
  "scripts": {
    "build": "nest build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "ioredis": "^5.11.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.1.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
