{
  "name": "loreweave-monorepo-game",
  "version": "0.0.0",
  "private": true,
  "description": "pnpm workspace root for the LoreWeave MMORPG client (frontend-game + shared packages). The novel-workflow frontend/ is intentionally NOT part of this workspace \u2014 see spec \u00a71 #5.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "game:dev": "pnpm --filter frontend-game dev",
    "game:build": "pnpm --filter frontend-game build",
    "game:test": "pnpm --filter frontend-game test",
    "packages:build": "pnpm -r --filter \"./packages/*\" build",
    "lint": "eslint frontend-game packages",
    "lint:fix": "eslint frontend-game packages --fix"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5",
    "@eslint/js": "^10",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8"
  }
}
