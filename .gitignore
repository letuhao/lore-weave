# the authoritative longitudinal record is the enrichment_eval_runs DB table).
eval/baselines/enrichment-v1-live.json

# Local-only dev dumps & ad-hoc smoke scripts (underscore-prefixed convention)
services/**/_*.json
services/**/scripts/_*.py
# …except the motif translation sidecar, which is SHIPPED seed data, not a dump. It
# records which English text each translation was made from; without it the seeder
# re-derives the hash from the current source and every translation reads as fresh
# however far the English has moved — the staleness flag becomes decorative. It is
# `_`-prefixed for the loader's benefit (that prefix is how the seeder tells a report
# file from a translation file), which is what collided with the convention above.
# `_FAILED.json` is a genuine local run report and stays ignored.
!services/composition-service/app/db/seed_motif_packs/translations/**/_source_hash.json

# raw-search EVAL-CI run log (append-only, generated)
services/knowledge-service/eval/rawsearch_eval_runs.jsonl

